{
  "manifest_version": 3,
  "name": "AI Phishing Detector",
  "version": "1.0.0",
  "description": "ตรวจสอบความเสี่ยง Phishing URL ด้วย Machine Learning",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_title": "AI Phishing Detector",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
